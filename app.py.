import streamlit as st
import pandas as pd

st.set_page_config(page_title="Tính Lãi Tiết Kiệm", page_icon="💰", layout="centered")

st.title("💰 Công Cụ Tính Lãi Suất Tiết Kiệm Ngân Hàng")

st.subheader("📌 Nhập thông tin khoản gửi")
col1, col2 = st.columns(2)

with col1:
    principal = st.number_input("Số tiền gửi ban đầu (VNĐ):", min_value=1000000, value=100000000, step=1000000, format="%d")
    interest_rate = st.number_input("Lãi suất (%/năm):", min_value=0.1, value=6.0, step=0.1, format="%.1f")

with col2:
    months = st.number_input("Kỳ hạn gửi (tháng):", min_value=1, value=12, step=1)
    payout_method = st.selectbox("Hình thức nhận lãi:", ["Lãi nhập gốc (Lãi kép)", "Lãi nhận hàng tháng"])

monthly_rate = (interest_rate / 100) / 12

if payout_method == "Lãi nhập gốc (Lãi kép)":
    total_amount = principal * ((1 + monthly_rate) ** months)
    total_interest = total_amount - principal
else:
    total_interest = principal * monthly_rate * months
    total_amount = principal + total_interest

st.divider()
st.subheader("📊 Kết quả dự tính")

col_a, col_b, col_c = st.columns(3)
col_a.metric("Tiền gốc", f"{principal:,.0f} VNĐ")
col_b.metric("Tổng tiền lãi", f"{total_interest:,.0f} VNĐ")
col_c.metric("Tổng tiền nhận được", f"{total_amount:,.0f} VNĐ")

st.subheader("📅 Bảng chi tiết từng tháng")
schedule = []
current_balance = principal

for month in range(1, months + 1):
    if payout_method == "Lãi nhập gốc (Lãi kép)":
        month_interest = current_balance * monthly_rate
        current_balance += month_interest
        schedule.append({"Tháng": month, "Tiền lãi (VNĐ)": round(month_interest), "Số dư (VNĐ)": round(current_balance)})
    else:
        month_interest = principal * monthly_rate
        schedule.append({"Tháng": month, "Tiền lãi (VNĐ)": round(month_interest), "Lãi tích lũy (VNĐ)": round(month_interest * month)})

df_schedule = pd.DataFrame(schedule)
st.dataframe(df_schedule, use_container_width=True)
